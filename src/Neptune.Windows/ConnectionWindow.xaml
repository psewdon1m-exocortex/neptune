<Window x:Class="Neptune.Windows.ConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neptune connection" Width="500" Height="640" MinWidth="500" MinHeight="640" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BlackBrush}" Foreground="{DynamicResource WhiteBrush}"
        FontFamily="{DynamicResource InterfaceFont}" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True" Icon="neptune.ico">
    <Grid Background="{DynamicResource BlackBrush}">
        <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="65"/></Grid.RowDefinitions>

        <Border BorderBrush="{DynamicResource WhiteBrush}" BorderThickness="0,0,0,1" Padding="20,10">
            <TextBlock Text="connection" FontFamily="{DynamicResource DisplayFont}" FontSize="36" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
        </Border>

        <Border Grid.Row="1" Margin="20" BorderBrush="{DynamicResource WhiteBrush}" BorderThickness="1" Background="{DynamicResource BlackBrush}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="55"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border BorderBrush="{DynamicResource White80Brush}" BorderThickness="0,0,0,1" Padding="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="01" FontSize="12" Foreground="{DynamicResource White80Brush}" VerticalAlignment="Center" />
                        <TextBlock Text="Saturn enrollment" Margin="10,0,0,0" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="1" Margin="20">
                    <TextBlock Foreground="{DynamicResource White80Brush}" TextWrapping="Wrap" LineHeight="21"
                               Text="Connect this Neptune profile through Kernel and redeem the one-time setup code created in Saturn." />

                    <TextBlock Margin="0,20,0,6" Text="Kernel HTTPS origin" />
                    <TextBox x:Name="KernelOrigin" Text="https://kernel.example.com" />

                    <TextBlock Margin="0,20,0,6" Text="Kernel service token" />
                    <PasswordBox x:Name="KernelToken" />

                    <TextBlock Margin="0,20,0,6" Text="Saturn setup code" />
                    <PasswordBox x:Name="SaturnToken" />

                    <Border Margin="0,20,0,0" BorderBrush="{DynamicResource White80Brush}" BorderThickness="1" Padding="12">
                        <TextBlock Foreground="{DynamicResource White80Brush}" TextWrapping="Wrap" LineHeight="21"
                                   Text="Neptune exchanges the setup code for a scoped device credential. The credential is protected for the current Windows user and is never shown again in Saturn." />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" BorderBrush="{DynamicResource WhiteBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button Content="Cancel" IsCancel="True" />
                <Button Grid.Column="2" Content="Save connection" Click="Save_Click" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</Window>
