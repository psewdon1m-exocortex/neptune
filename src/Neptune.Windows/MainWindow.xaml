<Window x:Class="Neptune.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neptune" Width="500" Height="800" MinWidth="500" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BlackBrush}" Foreground="{DynamicResource WhiteBrush}"
        FontFamily="{DynamicResource InterfaceFont}" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True" Icon="neptune.ico">
    <Grid Background="{DynamicResource BlackBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="{DynamicResource WhiteBrush}" BorderThickness="0,0,0,1" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Image Source="neptune.png" Width="60" Height="60" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="neptune" FontFamily="{DynamicResource DisplayFont}" FontSize="38" FontWeight="Bold" LineHeight="40" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock x:Name="ProfileLabel" FontSize="11" Foreground="{DynamicResource White80Brush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" BorderBrush="{DynamicResource White80Brush}" BorderThickness="1" Background="{DynamicResource BlackBrush}" Padding="10,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="122"/></Grid.ColumnDefinitions>
                        <Rectangle x:Name="ConnectionDot" Width="10" Height="10" Fill="#697680" VerticalAlignment="Center" />
                        <TextBlock x:Name="ConnectionStatus" Grid.Column="1" Text="Not configured" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2" Content="Connection" Click="Connection_Click" MinHeight="34" Height="34" Margin="0,2" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,10,0,-10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <CheckBox x:Name="AutostartToggle" Content="Start with Windows" Checked="Autostart_Changed" Unchecked="Autostart_Changed" />
                    <Button x:Name="UpdateButton" Grid.Column="2" Content="Check updates" Click="Update_Click" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="synchronization" FontFamily="{DynamicResource DisplayFont}" FontSize="38" FontWeight="Bold" LineHeight="42" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Grid.Row="1" Margin="0,8,0,20" Foreground="{DynamicResource White80Brush}" TextWrapping="Wrap" LineHeight="21"
                       Text="One-way mirror of selected local folders. Local deletions are reflected in Saturn; remote changes never affect this computer." />

            <Border Grid.Row="2" BorderBrush="{DynamicResource WhiteBrush}" BorderThickness="1" Background="{DynamicResource BlackBrush}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="55"/><RowDefinition Height="*"/><RowDefinition Height="65"/></Grid.RowDefinitions>

                    <Border BorderBrush="{DynamicResource White80Brush}" BorderThickness="0,0,0,1" Padding="12,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="01" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource White80Brush}" />
                            <TextBlock Grid.Column="1" Text="Folders" Margin="10,0,0,0" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                            <Grid Grid.Column="2" Width="20" Height="20" VerticalAlignment="Center" ToolTip="Fixed synchronization card">
                                <Ellipse Width="4" Height="4" Fill="{DynamicResource DecorativeDotBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,2,0,0" />
                                <Ellipse Width="4" Height="4" Fill="{DynamicResource DecorativeDotBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" />
                                <Ellipse Width="4" Height="4" Fill="{DynamicResource DecorativeDotBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2,0,0,2" />
                                <Ellipse Width="4" Height="4" Fill="{DynamicResource DecorativeDotBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="12,12,12,2">
                        <ListBox x:Name="MappingsList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource WhiteBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="40"/></Grid.RowDefinitions>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1" Margin="0,4,0,10" Text="{Binding LocalPath}" Foreground="{DynamicResource White80Brush}" FontSize="11" TextWrapping="Wrap" />
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="104"/></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Rectangle Width="10" Height="10" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0" />
                                                <TextBlock Text="Ready" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Remove" Tag="{Binding}" Click="Remove_Click" Style="{StaticResource DangerButtonStyle}" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="No local folders selected. Add a folder to begin one-way synchronization."
                                   Margin="18" Foreground="{DynamicResource White80Brush}" TextWrapping="Wrap" LineHeight="21" VerticalAlignment="Top" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding ElementName=MappingsList, Path=HasItems}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Border Grid.Row="2" BorderBrush="{DynamicResource White80Brush}" BorderThickness="0,1,0,0" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Content="Add local folder" Click="AddDirectory_Click" />
                            <Button x:Name="SyncButton" Grid.Column="2" Content="Sync now" Click="Sync_Click" Style="{StaticResource PrimaryButtonStyle}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{DynamicResource WhiteBrush}" BorderThickness="0,1,0,0" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterStatus" Text="Ready" VerticalAlignment="Center" Foreground="{DynamicResource White80Brush}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ClientLabel" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#999999" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>
