<Window x:Class="Neptune.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neptune" Width="800" Height="500" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen" Background="#090B0E" Foreground="White"
        Icon="neptune.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="48"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="#33404A" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image Source="neptune.png" Width="46" Height="46" Stretch="Uniform" />
                <StackPanel Grid.Column="1" Margin="14,2,0,0">
                    <TextBlock Text="NEPTUNE" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock x:Name="ProfileLabel" FontFamily="Cascadia Mono" FontSize="11" Foreground="#93A2AD" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#697680" Margin="0,0,8,0" />
                    <TextBlock x:Name="ConnectionStatus" Text="Not configured" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Content="Connection" Click="Connection_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="SYNC WITH SATURN" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Margin="0,4,0,14" Foreground="#93A2AD"
                       Text="One-way mirror of selected local directories. Local deletions are reflected in Saturn; remote changes never affect this computer." />
            <Border Grid.Row="2" Background="#11151A" BorderBrush="#33404A" BorderThickness="1">
                <ListBox x:Name="MappingsList" Background="Transparent" BorderThickness="0" Foreground="White">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,9" Width="700">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="125"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding LocalPath}" Foreground="#93A2AD" FontFamily="Cascadia Mono" FontSize="11" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="Ready" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Content="Remove" Tag="{Binding}" Click="Remove_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Button Content="Add local directory" HorizontalAlignment="Left" Click="AddDirectory_Click" />
                <Button x:Name="SyncButton" Content="Sync now" HorizontalAlignment="Right" Width="115" Background="{DynamicResource AccentBrush}" Foreground="#001018" FontWeight="SemiBold" Click="Sync_Click" />
            </Grid>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#33404A" BorderThickness="0,1,0,0" Padding="20,0">
            <Grid>
                <TextBlock x:Name="FooterStatus" Text="Ready" VerticalAlignment="Center" Foreground="#93A2AD" />
                <TextBlock x:Name="ClientLabel" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Cascadia Mono" FontSize="10" Foreground="#697680" />
            </Grid>
        </Border>
    </Grid>
</Window>
