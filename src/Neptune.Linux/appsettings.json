{
  "Neptune": {
    "StateDirectory": "/var/lib/neptune",
    "RegistryPath": "/var/lib/neptune/projects.json",
    "SocketPath": "/run/neptune/neptuned.sock",
    "KernelOrigin": "https://kernel.example.com",
    "KernelTokenFile": "/etc/neptune/kernel.token",
    "MaxParallelProjects": 4,
    "RegisterRefreshSeconds": 60,
    "RemoteControlPollSeconds": 15,
    "UpdaterSocketPath": "/run/exocortex/updater.sock",
    "UpdaterAgentTokenFile": "/etc/neptune/updater-agent.token"
  }
}
